# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environment
.venv/
.env

# Model artifacts: archived versions stay local. The registry and the active artifact
# (about 0.4 MB) are committed so a fresh clone works without retraining. After activating
# a different version, update the two artifact lines below to its file names.
models/*
!models/.gitkeep
!models/registry.json
!models/loanlens_model_1.0.0.joblib
!models/loanlens_model_1.0.0.json

# Raw data (large / third-party; never commit bank data)
data/raw/*
!data/raw/.gitkeep

# Processed copy of the third-party dataset: rebuilt by `python -m loanlens.model`
data/processed/*
!data/processed/.gitkeep

# Local fresh-clone simulation
.fresh_clone_test/

# Local databases
*.db
*.sqlite
*.sqlite3
*.egg-info/

# Local secrets (manager password); never commit
.streamlit/secrets.toml
.coverage
htmlcov/
*.sqlite*

# Large generated test files (e.g. 50k-row stress tests)
big_*.csv
