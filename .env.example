# LoanLens configuration. Copy to .env (never committed) or set these in the environment.
# Names only: no values, secrets or passwords belong in this file.

# Database for anonymised batch summaries. Unset: sqlite:///data/loanlens.sqlite
# PostgreSQL example form: postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# Pin a registered model version instead of the active one (see python -m loanlens.model --list)
LOANLENS_MODEL_VERSION=

# Session signing key, at least 32 random characters. Unset in local development: a temporary
# key is used (with a warning). Required when LOANLENS_ENV=production or LOANLENS_HOSTED=1.
LOANLENS_JWT_SECRET=
LOANLENS_ENV=
LOANLENS_HOSTED=

# Optional account settings (defaults: 60 minutes, 5 attempts, 15 minutes)
LOANLENS_SESSION_MINUTES=
LOANLENS_LOCKOUT_ATTEMPTS=
LOANLENS_LOCKOUT_MINUTES=

# One-time creation of the first manager (only while no manager exists). Remove afterwards.
LOANLENS_BOOTSTRAP_MANAGER_EMAIL=
LOANLENS_BOOTSTRAP_MANAGER_PASSWORD=

# REST API (python -m loanlens.api or uvicorn loanlens.api.app:app)
LOANLENS_API_HOST=
LOANLENS_API_PORT=
# Most applicants per POST /v1/score/batch (default 1000)
LOANLENS_API_MAX_BATCH=
# Comma-separated allowed CORS origins; empty means CORS is off
LOANLENS_API_CORS_ORIGINS=
# Sign-in and registration limits (defaults: 10 per client address, 5 per account, 60 seconds)
LOANLENS_API_AUTH_LIMIT_PER_CLIENT=
LOANLENS_API_AUTH_LIMIT_PER_ACCOUNT=
LOANLENS_API_AUTH_WINDOW_SECONDS=

# Batch jobs (Bulk Check and POST /v1/batches). Defaults in brackets.
# Private directory for uploads and results [data/jobs]; keep it outside any public folder
LOANLENS_JOBS_DIR=
# Days before finished jobs' result and error files are deleted [7]
LOANLENS_JOB_RETENTION_DAYS=
# Start a background-thread worker inside the app when no external worker runs [1]
LOANLENS_EMBEDDED_WORKER=
# Rows per chunk [20000], most rows per job [1000000], largest API upload in MB [200]
LOANLENS_JOB_CHUNK_SIZE=
LOANLENS_JOB_MAX_ROWS=
LOANLENS_JOB_MAX_UPLOAD_MB=
# Audit records per scored batch row: row [row] or off (benchmarks only; refused in production)
LOANLENS_BATCH_AUDIT=
# Audit records per bulk insert [1000]
LOANLENS_BATCH_AUDIT_CHUNK=
# Idle worker poll interval in seconds [2]; heartbeat age before a running job is failed [300]
LOANLENS_WORKER_POLL_SECONDS=
LOANLENS_JOB_STALE_SECONDS=

# Tests only: a disposable PostgreSQL database for the optional PostgreSQL tests
LOANLENS_TEST_POSTGRES_URL=
